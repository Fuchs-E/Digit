<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Digit ribbon (Office 2010+ schema). Callbacks live in DigitRibbon.bas.
  Quick buttons carry their slot number in "tag"; labels, visibility and tips
  come from presets.json through the get* callbacks, so editing presets and
  calling Invalidate is enough to update the ribbon.
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Digit_RibbonOnLoad">
  <ribbon>
    <tabs>
      <!-- Digit is a group on the Home tab, right after Excel's Number group.
           Small buttons (the default) stack three to a column: quick buttons
           1-3, then 4, 5 and Undo Format (bottom right). With "Large quick
           buttons" in Settings, Digit_GetSize makes them large, one per
           column. The large Digit menu sits on the right. When the window is narrow, Excel collapses the group to the
           Digit icon. Quick-button pictures come from each group's "icon". -->
      <tab idMso="TabHome">
        <group id="grpDigit" label="Digit" image="digitIcon" insertAfterMso="GroupNumber">
          <button id="btnDigitQuick1" tag="1" label=" " showLabel="false" getSize="Digit_GetSize" getImage="Digit_GetImage"
                  getVisible="Digit_GetVisible" getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick2" tag="2" label=" " showLabel="false" getSize="Digit_GetSize" getImage="Digit_GetImage"
                  getVisible="Digit_GetVisible" getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick3" tag="3" label=" " showLabel="false" getSize="Digit_GetSize" getImage="Digit_GetImage"
                  getVisible="Digit_GetVisible" getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick4" tag="4" label=" " showLabel="false" getSize="Digit_GetSize" getImage="Digit_GetImage"
                  getVisible="Digit_GetVisible" getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick5" tag="5" label=" " showLabel="false" getSize="Digit_GetSize" getImage="Digit_GetImage"
                  getVisible="Digit_GetVisible" getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitUndo" label="Undo Format" showLabel="false" getSize="Digit_GetSize" imageMso="Undo"
                  screentip="Undo Format" getSupertip="Digit_GetUndoSupertip"
                  getEnabled="Digit_GetUndoEnabled" onAction="Digit_OnUndo"/>
          <!-- Everything else: groups 6 onwards, Settings, Reload, Check for
               updates and the version (built in Digit_GetMenuContent). -->
          <dynamicMenu id="mnuDigit" label="Digit" size="large" image="digitIcon"
                       screentip="Digit"
                       supertip="More presets, Settings, Reload presets and Check for updates."
                       getContent="Digit_GetMenuContent" invalidateContentOnDrop="true"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
