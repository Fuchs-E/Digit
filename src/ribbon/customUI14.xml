<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Digit ribbon (Office 2010+ schema). Callbacks live in DigitRibbon.bas.
  Quick buttons carry their slot number in "tag"; labels, visibility and tips
  come from presets.json through the get* callbacks, so editing presets and
  calling Invalidate is enough to update the ribbon.
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Digit_RibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="tabDigit" label="Digit" insertAfterMso="TabHome">

        <group id="grpDigitQuick" label="Quick formats">
          <button id="btnDigitQuick1" tag="1" size="large" imageMso="_1"
                  getLabel="Digit_GetLabel" getVisible="Digit_GetVisible"
                  getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick2" tag="2" size="large" imageMso="_2"
                  getLabel="Digit_GetLabel" getVisible="Digit_GetVisible"
                  getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick3" tag="3" size="large" imageMso="_3"
                  getLabel="Digit_GetLabel" getVisible="Digit_GetVisible"
                  getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick4" tag="4" size="large" imageMso="_4"
                  getLabel="Digit_GetLabel" getVisible="Digit_GetVisible"
                  getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick5" tag="5" size="large" imageMso="_5"
                  getLabel="Digit_GetLabel" getVisible="Digit_GetVisible"
                  getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
        </group>

        <group id="grpDigitMore" label="Presets">
          <dynamicMenu id="mnuDigitMore" label="More presets" size="large" imageMso="FormatPainter"
                       screentip="More presets"
                       supertip="Preset groups that are not on a quick button."
                       getContent="Digit_GetMoreContent" invalidateContentOnDrop="true"/>
        </group>

        <group id="grpDigitTools" label="Digit">
          <button id="btnDigitUndo" label="Undo Format" size="large" imageMso="Undo"
                  screentip="Undo Format" getSupertip="Digit_GetUndoSupertip"
                  getEnabled="Digit_GetUndoEnabled" onAction="Digit_OnUndo"/>
          <button id="btnDigitSettings" label="Settings" size="large" imageMso="PropertySheet"
                  screentip="Digit Settings"
                  supertip="Create, edit and reorder preset groups, assign them to the quick buttons, and set keyboard shortcuts."
                  onAction="Digit_OnSettings"/>
          <button id="btnDigitReload" label="Reload presets" imageMso="Refresh"
                  screentip="Reload presets"
                  supertip="Read presets.json again, for example after editing it by hand or replacing it with a shared copy."
                  onAction="Digit_OnReload"/>
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
