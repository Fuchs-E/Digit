<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Digit ribbon (Office 2010+ schema). Callbacks live in DigitRibbon.bas.
  Quick buttons carry their slot number in "tag"; labels, visibility and tips
  come from presets.json through the get* callbacks, so editing presets and
  calling Invalidate is enough to update the ribbon.
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Digit_RibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="tabDigit" label="Digit" insertAfterMso="TabHome">

        <!-- Large icon-only buttons; the group name shows as the tooltip. Excel
             ignores showLabel="false" on large buttons, so the label is a blank. Each
             button's picture comes from its group's "icon" (an Office icon name). -->
        <group id="grpDigitQuick" label="Quick formats">
          <button id="btnDigitQuick1" tag="1" size="large" label=" " getImage="Digit_GetImage" getVisible="Digit_GetVisible"
                  getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick2" tag="2" size="large" label=" " getImage="Digit_GetImage" getVisible="Digit_GetVisible"
                  getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick3" tag="3" size="large" label=" " getImage="Digit_GetImage" getVisible="Digit_GetVisible"
                  getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick4" tag="4" size="large" label=" " getImage="Digit_GetImage" getVisible="Digit_GetVisible"
                  getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
          <button id="btnDigitQuick5" tag="5" size="large" label=" " getImage="Digit_GetImage" getVisible="Digit_GetVisible"
                  getScreentip="Digit_GetScreentip" getSupertip="Digit_GetSupertip"
                  onAction="Digit_OnQuick"/>
        </group>

        <group id="grpDigitTools" label="Digit">
          <button id="btnDigitUndo" label="Undo Format" size="large" imageMso="Undo"
                  screentip="Undo Format" getSupertip="Digit_GetUndoSupertip"
                  getEnabled="Digit_GetUndoEnabled" onAction="Digit_OnUndo"/>
          <!-- One menu for everything else: other presets, Settings, Reload,
               Check for updates and the version (built in Digit_GetMenuContent). -->
          <dynamicMenu id="mnuDigit" label="Digit" size="large" image="digitIcon"
                       screentip="Digit"
                       supertip="More presets, Settings, Reload presets and Check for updates."
                       getContent="Digit_GetMenuContent" invalidateContentOnDrop="true"/>
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
